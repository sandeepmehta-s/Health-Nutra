# Server Configuration
PORT=5000

# Database Configuration (MongoDB)
# Local: mongodb://127.0.0.1:27017/health_nutra
# Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/health_nutra?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/health_nutra

# Session Secret (change in production)
SESSION_SECRET=your_super_secret_session_key_change_in_production

# Default Admin Credentials (seeded on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email & Integrations (Optional)
VITE_BREVO_API_KEY=your_brevo_api_key
VITE_BREVO_SENDER=verified-sender@yourdomain.com
VITE_ADMIN_EMAIL=healthnutra16@gmail.com
VITE_ADMIN_PASS=admin
VITE_SHEET_URL=https://script.google.com/macros/s/XXXX/exec
