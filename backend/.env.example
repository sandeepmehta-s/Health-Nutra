# Server & Application URLs (used for local and production deployment)
PORT=5000
HOST=0.0.0.0
# In production, set APP_URL to your live domain (e.g. https://health-nutra.onrender.com)
APP_URL=http://localhost:5000
API_URL=http://localhost:5000/api

# Database (MongoDB Atlas / Mongoose)
# Provide your MongoDB Atlas or local MongoDB connection URI:
MONGODB_URI=mongodb://127.0.0.1:27017/health_nutra
SESSION_SECRET=health-nutra-secure-production-secret-key-2026

# Admin Credentials (Set strong custom credentials)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password

# Keep-Alive Cron (Every 5 minutes)
PING_INTERVAL_MINUTES=5

# Cloudinary Image & Logo Storage (Persistent CDN for product images and brand logos)
CLOUDINARY_CLOUD_NAME=usqwgkl7
CLOUDINARY_API_KEY=173632714251558
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
# Optional custom logo image URL
BRAND_LOGO_URL=https://res.cloudinary.com/usqwgkl7/image/upload/v1792576055/logo.jpg

# Optional Third-Party Services
VITE_BREVO_API_KEY=your_brevo_api_key
VITE_BREVO_SENDER=your-email@example.com
VITE_ADMIN_EMAIL=your-email@example.com
